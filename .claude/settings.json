{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": false
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(./riftbound-france-*.json)",
      "Read(./client_secret_*.json)",
      "Read(**/*service-account*.json)",
      "Read(./dump.sql)",
      "Read(./dump2.sql)",

      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(sudo rm *)",
      "PowerShell(Remove-Item -Recurse -Force *)",
      "PowerShell(rm -rf *)",

      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin +*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "Bash(git reset --hard*)",
      "PowerShell(git reset --hard*)",
      "Bash(git clean -fdx*)",
      "Bash(git branch -D*)",
      "Bash(git checkout -- *)",

      "Bash(npx prisma migrate reset*)",
      "Bash(npx prisma db push --accept-data-loss*)",
      "PowerShell(npx prisma migrate reset*)",
      "PowerShell(npx prisma db push --accept-data-loss*)",
      "Bash(psql * -c DROP*)",
      "Bash(dropdb *)",
      "Bash(docker compose down -v*)",
      "Bash(docker volume rm *)"
    ],
    "ask": [
      "Bash(git push*)",
      "PowerShell(git push*)",
      "Bash(gh pr merge*)",
      "Bash(gh release*)",

      "Bash(docker *)",
      "PowerShell(docker *)",
      "Bash(coolify*)",
      "Bash(ssh *)",
      "Bash(scp *)",

      "Bash(npx prisma db push*)",
      "Bash(npx prisma migrate*)",
      "PowerShell(npx prisma db push*)",
      "PowerShell(npx prisma migrate*)",
      "Bash(npx tsx scripts/seed-*)",
      "Bash(npx tsx prisma/seed-*)",
      "PowerShell(npx tsx scripts/seed-*)",
      "PowerShell(npx tsx prisma/seed-*)",
      "Bash(npx tsx scripts/sync-*)",
      "Bash(node migrate.mjs*)",

      "Write(./.env*)",
      "Edit(./.env*)",
      "Write(./public/**)",
      "Edit(./prisma/schema.prisma)"
    ]
  }
}

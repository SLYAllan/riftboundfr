# Variables d'environnement — Riftbound France
#
# Copier en `.env` et remplir. Aucune vraie valeur ici.
# `.env*` est ignoré par git sauf ce fichier.
# En production, ces variables sont posées dans Coolify, pas dans un fichier.

# --- Base de données (obligatoire) ---------------------------------------
# Chaîne de connexion Prisma. En local, `docker compose up -d db` monte un
# PostgreSQL 16 sur le port 5433 (et non 5432, pour ne pas heurter un
# PostgreSQL déjà installé sur la machine).
# Local : postgresql://postgres:postgres@127.0.0.1:5433/riftbound
DATABASE_URL=

# --- Sessions (obligatoire) ----------------------------------------------
# Clé HMAC qui signe les deux cookies de session : `riftbound_admin`
# (back-office) et `riftbound_session` (compte Discord). Le code n'a AUCUN
# repli : sans cette variable, toute page qui lit une session lève une erreur.
# Générer avec : openssl rand -hex 32
SESSION_SECRET=

# --- Back-office (obligatoire pour /admin) -------------------------------
# Mot de passe unique du formulaire /admin/login. Ne sert jamais à signer
# quoi que ce soit : c'est SESSION_SECRET qui signe le cookie posé après.
ADMIN_PASSWORD=

# --- URL publique (recommandé) -------------------------------------------
# Base des URL canoniques, du sitemap, des images Open Graph et de l'adresse
# de retour Discord. Sans elle, le code retombe sur https://riftboundfrance.fr,
# ce qui casse la connexion Discord en local.
# Local : http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# --- Connexion Discord (facultatif) --------------------------------------
# Sans ces deux valeurs, le bouton « Se connecter » échoue mais le reste du
# site marche. L'adresse de retour à déclarer côté Discord est
# <NEXT_PUBLIC_SITE_URL>/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Google Analytics (facultatif) ---------------------------------------
# Vide = aucun script de mesure n'est chargé.
NEXT_PUBLIC_GA_ID=

# --- Drapeaux de scripts (facultatif) ------------------------------------
# `scripts/seed-fiche-articles.mts` est désactivé par défaut (ses articles font
# doublon avec /legendes). Mis à 1, il seede quand même.
RESEED_FICHES=

{
  "name": "riftboundfr",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "sync-cards": "npx tsx scripts/sync-cards.ts",
    "sync-prices": "npx tsx --env-file=.env scripts/sync-prices.mts",
    "verify": "tsc --noEmit && next build",
    "validate:names": "npx tsx scripts/validate-card-names.mts",
    "fix:names": "npx tsx scripts/validate-card-names.mts --fix",
    "validate:decks": "python -X utf8 scripts/validate-decklists.py"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@prisma/client": "^6.19.3",
    "class-variance-authority": "^0.7.1",
